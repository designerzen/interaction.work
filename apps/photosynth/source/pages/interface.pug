extends _base.pug

block above 
	#load-progress
		label(for="progress-bar") Please wait <br>loading may take a long time
			span.load-percent 0%
		progress(max=1 role="progressbar" aria-describedby="app" title="Load progress" value=0 )#progress-bar.donut
		
block nav
	ul
		li: a#link-about(href="#fund" aria-label="Learn more about this project" onclick="window.fund.showModal()") About<span class="hide-text"> this project and how to help fund it<span>
		li: a(href="#help" aria-label="Show some helpful information" onclick="window.help.showModal()") Help!

block preload
	script document.documentElement.classList.add("loading","app")
	link(rel="preload" href="/index.js" as="script") 

block scripts
	script(type="module" src="/index.ts")

block main
	include ../components/a11y.pug
		
	main#app(aria-describedby="progress-bar")
		
		h3(screenreader-only)#title Augmented Reality Synthesizer
		h4(screenreader-only)#subtitle 

		p(role="status" aria-live="polite" popover="manual")#feedback Loading please wait!
		include ../components/toast.pug		

		a(href="/")#share-code
			// logo OR QR code
			.qr 
				img(src="/assets/qr/interface.place-red.png" alt="QR code linking to the PhotoSYNTH website" onerror="this.style.display='none'")
			
			p Share with friends

		#app-frame

			//- Pick how many people etc
			include ../components/onboarding.pug

			//- THE video element fed by video camera			
			video#webcam(autoplay, playsinline, width="640", height="480")
				p No Video available - unable to playback emoji

			//- we clone the video onto the canvas every frame - this has a JS helper
			//- that deletes this node and re-creates it with a different context
			canvas#photosynth-canvas.canvas-full-size(width="640", height="480")
			canvas#photosynth-sandwich.canvas-full-size(width="640", height="480")
			canvas#photosynth-overlay.canvas-full-size(width="640", height="480")
			
			//- In APP CONTROLS ------------------------------------------------------
			
			//- control panel with multi-levels
			include ../components/control-panel.pug

			//- MIDI FILE Uploader
			form#upload-midi-form
				label(for="midi-upload-input") Upload a MIDI backing track!
				input#midi-upload-input(type="file" hidden name="midi-upload")
				button#button-midi-upload( type="button" ) Upload MIDI file

		//-  For users with javascript disabled 
		noscript
			p
				| This application requires javascript to work unfortunately and doesn't do much without it. 
				| You can install 
				
	#contact
		h4 Contact 
		p If you have any suggestions, concerns, ideas or feedback, please get in touch!
		a.email-address.button.button-push.button-email.centralise(href="mailto:radio@awesomething.co.uk") Contact<span class="sr-only"> via Email</span> radio@awesomething.co.uk

	#affiliates
		block affiliates
			h3 Affiliates & Representatives
			include ../components/affiliates.pug

	small#attributions
		block attributions
		
block dialogs 
	include ../components/dialogs.pug

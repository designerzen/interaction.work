	"scripts": {
		"postinstall": "electron-builder install-app-deps",
		"start": "pnpm run dev",
		"dev": "pnpm run copy && vite",
		"build": "vite build",
		"preview": "vite preview",
		"application": "=======================================================================================",
		"electron": "electron .",
		"electron:dev": "electron-vite dev",
		"electron:build": "pnpm electron:icons && vite build && electron-vite build",
		"electron:preview": "electron-vite preview",
		"electron:dist": "pnpm run electron:build && electron-builder",
		"dist:dir": "pnpm run electron:build && electron-builder --dir",
		"dist:win": "pnpm run electron:build && electron-builder --win",
		"dist:mac": "pnpm run electron:build && electron-builder --mac",
		"dist:linux": "pnpm run electron:build && electron-builder --linux",
		"electron:icons": "electron-icon-maker --input=./source/assets/icons/icon.png --output=./build",
		"actions": "=======================================================================================",
		"changes": "node actions/changelog.mjs",
		"clean": "node actions/clean.mjs",
		"copy": "node actions/copy.mjs",
		"release:patch": "node ../../actions/release.mjs patch",
		"release:minor": "node ../../actions/release.mjs minor",
		"release:major": "node ../../actions/release.mjs major",
		"assets": "pnpm run copy && pnpm run zips && pnpm run electron:icons",
		"clear": "pnpm run clean && pnpm run copy",
		"doc": "jsdoc -d docs --configure .jsdoc.json source/interface.js",
		"upgrader": "npx npm-check-updates --interactive -u",
		"testing": "=======================================================================================",
		"test": "vittest",
		"licences": "=======================================================================================",
		"copyrights:list": "NODE_ENV=production yarn licenses list && node license.mjs",
		"license:summary": "npx license-checker --summary > LICENSES.md && npx license-checker --summary > source/licenses.md",
		"license:table": "npx license-report --output=table >> LICENSES.md  && npx license-checker --output=table >> source/licenses.md",
		"license:smallprint": "pnpm run licenses generate-disclaimer >> LICENSES.md && pnpm run licenses generate-disclaimer >> source/licenses.md",
		"license:report": "npx license-report --output=markdown >> LICENSES.md && npx license-report --output=markdown >> source/licenses.md",
		"license": "pnpm run license:report && pnpm run license:smallprint && pnpm run license:table && pnpm run license:summary"
	},

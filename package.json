{
  "name": "interaction.works",
  "description": "Instant Musical Superpowers! Body controllable accessible musical instrument",
  "version": "0.40.2",
  "author": "designerzen <github@designerzen.com>",
  "license": "AGPL-3.0",
  "scripts": {
    "start": "pnpm run dev",
    "upgrader": "npx npm-check-updates --interactive -u",
    "test:projects": "vitest run",
    "test:projects:watch": "vitest --watch",
    "view-report": "turbo run view-report",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "electron:dev": "turbo run electron:dev",
    "electron:build": "turbo run electron:build",
    "dev": "turbo run dev --no-daemon",
	"devi": "pnpm --filter PhotoSYNTH run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "license": "turbo run license",
    "release:patch": "pnpm --filter photosynth release:patch",
    "release:minor": "pnpm --filter photosynth release:minor",
    "release:major": "pnpm --filter photosynth release:major"
  },
  "devDependencies": {
    "lerna": "^9.0.4",
    "turbo": "^2.8.7"
  },
  "keywords": [
    "music",
    "accessibility",
    "machine learning",
    "ai",
    "xr",
    "ar"
  ],
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
